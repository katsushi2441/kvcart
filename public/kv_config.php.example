<?php
/**
 * Kurage Vibe-Cart — 設定。**このファイルは Git に入れない**（kv_config.php にコピーして使う）。
 *
 * ドメインを移すときは KV_BASE を '' にするだけでよい。
 *   デモ    : https://exbridge.jp/exdirect/  → KV_BASE = '/exdirect'
 *   本番    : https://www.exdirect.net/      → KV_BASE = ''
 * どちらでも /product/11366 の形は同じなので、ブックマークがそのまま生きる。
 */
declare(strict_types=1);

define('KV_BASE', '/exdirect');           // 本番は ''


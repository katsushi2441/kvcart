<?php
/**
 * Kurage Vibe-Cart — 設定。**このファイルは Git に入れない**（kv_config.php にコピーして使う）。
 *
 * ドメインを移すときは KV_BASE を '' にするだけでよい。
 *   デモ    : https://exbridge.jp/exdirect/  → KV_BASE = '/exdirect'
 *   本番    : https://www.exdirect.net/      → KV_BASE = ''
 * どちらでも /product/11366 の形は同じなので、ブックマークがそのまま生きる。
 */
declare(strict_types=1);

define('KV_BASE', '/exdirect');           // 本番は ''

$KV_SHOP = [
    'name'     => 'X-Direct',
    'tagline'  => '仕事に役立つアイテムを直送・格安で',
    'company'  => '株式会社エクスブリッジ',
    'email'    => 'info@exdirect.net',
    'tel'      => '050-5436-6141',
    'fax'      => '052-388-7758',
    'manager'  => '小嶋　篤',
    'address'  => '名古屋市瑞穂区内浜町34-9 宝第二スカイハイツ305',
    // 銀行振込の案内（注文完了画面とメールに出す）
    'bank'     => "銀行名・支店名・口座種別・口座番号・口座名義をここに書きます。\n振込手数料はお客様のご負担でお願いします。",
    // 在庫・納期を確かめたあとの「納期とお振込先のご案内」メールに入る口座（差し込み {bank_account}）。
    // 'bank' を「振込先は在庫確認後にご案内します」のような案内文にしているときは、ここに口座を書く。
    'bank_account' => "",
    // 請求書・領収書（帳票PDF）に印字する。適格請求書発行事業者の登録番号（T＋13桁）と郵便番号
    'invoice_no' => '',
    'zip'        => '',
    'ship_note'=> '送料は商品ページの表記に従います。',
];

// Stripe（カード払いの請求書・kv_stripe.php）。**空のままならカードの選択肢を出さない。**
// secret は制限付きキー（rk_…）。権限は Customers・Invoices・Invoice Items の書き込みだけ。
// webhook は、ダッシュボードで https://<ドメイン>/stripe_webhook.php を登録したときの署名シークレット（whsec_…）。
// 選ぶイベント: invoice.paid / invoice.payment_failed / invoice.voided
// kbilling と同じ考え方で、鍵が無いのにボタンだけ出して「押せない」状態を作らない。
$KV_STRIPE = [
    'publishable' => '',
    'secret'      => '',
    'webhook'     => '',
];

// 管理画面のログイン。パスワードは password_hash() の値を入れる
$KV_ADMIN = [
    'user' => 'admin',
    'hash' => '',   // 例: password_hash('ここにパスワード', PASSWORD_DEFAULT) の出力
];
